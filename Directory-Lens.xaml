<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Directory Lens | Offline lookup" Width="1280" Height="860" MinWidth="1060" MinHeight="740" WindowStartupLocation="CenterScreen" Background="#F3F5F8" FontFamily="Segoe UI" FontSize="13" Foreground="#18283B">
 <Window.Resources>
  <SolidColorBrush x:Key="BrandAccent" Color="#1469C0"/><SolidColorBrush x:Key="BrandContrast" Color="White"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#263B50"/><Setter Property="BorderBrush" Value="#D8E0E9"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource BrandAccent}"/><Setter Property="Foreground" Value="{DynamicResource BrandContrast}"/><Setter Property="BorderBrush" Value="{DynamicResource BrandAccent}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#CAD6E5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,4"/><Setter Property="Padding" Value="14,12"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="11,9"/><Setter Property="BorderBrush" Value="#D5DEE8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EDF1F5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowHeight" Value="38"/><Setter Property="Background" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F8FAFC"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F0F4F8"/><Setter Property="Foreground" Value="#52657A"/><Setter Property="Padding" Value="12,12"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="195"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#12263E">
   <Grid Margin="18,28,18,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><Image x:Name="BrandLogo" Height="58" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,12" Visibility="Collapsed"/><TextBlock x:Name="BrandName" TextWrapping="Wrap" Text="DIRECTORY LENS" Foreground="White" FontSize="19" FontWeight="Bold"/><TextBlock x:Name="BrandSubtitle" TextWrapping="Wrap" Text="DIRECTORY LOOKUP" Foreground="#9AB4D0" FontSize="10" FontWeight="SemiBold" Margin="2,5,0,32"/>
     <Button x:Name="NavDevices" Content="Devices" Style="{StaticResource Nav}"/>
     <Button x:Name="NavUsers" Content="Users" Style="{StaticResource Nav}"/>
     <Button x:Name="NavBulk" Content="Bulk device lookup" Style="{StaticResource Nav}"/>
     <Button x:Name="NavBulkUsers" Content="Bulk user lookup" Style="{StaticResource Nav}"/>
     <Button x:Name="NavGroups" Content="Group membership" Style="{StaticResource Nav}"/>
     <Button x:Name="NavKql" Content="KQL generator" Style="{StaticResource Nav}"/>
     <Border Height="1" Background="#30445C" Margin="0,20,0,16"/>
     <Button x:Name="NavData" Content="Data and refresh" Style="{StaticResource Nav}"/>
     <Button x:Name="NavBranding" Content="Branding" Style="{StaticResource Nav}"/>
    </StackPanel>
    <StackPanel Grid.Row="2"><Border Background="#213D55" CornerRadius="5" Padding="10,7"><TextBlock Text="OFFLINE WORKSPACE" Foreground="#9DDDD4" FontSize="10" FontWeight="SemiBold"/></Border><TextBlock Text="Local snapshots.&#10;No live directory changes." Foreground="#96ADC6" FontSize="11" Margin="2,12,0,0" TextWrapping="Wrap"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="28,24,28,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,20"><StackPanel><TextBlock x:Name="PageTitle" Text="Device directory" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Find a device, inspect its identity, and copy what you need." Foreground="#63768A" Margin="0,6,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E4EBF3" CornerRadius="12" Padding="12,5"><TextBlock Text="PORTABLE  /  LOCAL" FontSize="10" Foreground="#49647D"/></Border></DockPanel>
   <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,10,0"><StackPanel><TextBlock Text="ENTRA DEVICES" FontSize="10" Foreground="#6A7C90"/><TextBlock x:Name="DeviceCount" Text="Loading..." FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,10,0"><StackPanel><TextBlock Text="USERS" FontSize="10" Foreground="#6A7C90"/><TextBlock x:Name="UserCount" Text="Loading..." FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
    <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16,12"><StackPanel><TextBlock Text="DATA SOURCE" FontSize="10" Foreground="#6A7C90"/><TextBlock Text="Offline snapshots" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="View source dates in Data and refresh" FontSize="10" Foreground="#6A7C90" Margin="0,3,0,0"/></StackPanel></Border>
   </Grid>
   <StackPanel Grid.Row="2">
    <Border x:Name="SearchPanel" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16"><StackPanel><TextBlock x:Name="SearchLabel" Text="Full or partial device name" FontWeight="SemiBold" Margin="0,0,0,9"/><DockPanel><Button x:Name="SearchButton" DockPanel.Dock="Right" Content="Search" Style="{StaticResource Primary}" MinWidth="110" Margin="12,0,0,0"/><TextBox x:Name="SearchText" FontSize="15" AutomationProperties.Name="Search directory"/></DockPanel><TextBlock x:Name="SearchHint" Text="Partial matches help you browse. Search a full name before exporting group members." Foreground="#6A7C90" FontSize="11" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel></Border>
    <Border x:Name="BulkPanel" Visibility="Collapsed" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16"><StackPanel>
     <DockPanel><Button x:Name="ExampleButton" DockPanel.Dock="Right" Content="Save example CSV"/><Button x:Name="ChooseCsv" DockPanel.Dock="Left" Content="Choose CSV..." Style="{StaticResource Primary}" Margin="0,0,12,0"/><TextBlock x:Name="CsvFileLabel" Text="One device name per row. Extra columns are fine." VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
     <TextBlock x:Name="CsvColumnLabel" Text="Device-name column" Foreground="#52657A" Margin="0,12,0,6"/>
     <DockPanel><Button x:Name="RunBulk" DockPanel.Dock="Right" Content="Check devices" IsEnabled="False" Style="{StaticResource Primary}" Margin="12,0,0,0"/><CheckBox x:Name="NoHeaderCheck" DockPanel.Dock="Right" Content="First row is a device (no header)" VerticalAlignment="Center" Margin="12,0,0,0"/><ComboBox x:Name="ColumnPicker" MinWidth="180" Padding="8,6" AutomationProperties.Name="Device-name column"/></DockPanel>
     <TextBlock x:Name="CsvPreview" Text="Choose a file to preview its columns and device names." Foreground="#63768A" Margin="0,10,0,0" TextWrapping="Wrap" MaxHeight="48"/>
    </StackPanel></Border>
   </StackPanel>
   <Grid Grid.Row="3">
    <Border x:Name="ResultsPanel" Background="White" CornerRadius="8" Padding="1"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="16,12"><TextBlock x:Name="ResultsLabel" Text="Results" FontWeight="SemiBold"/><TextBlock x:Name="ResultCount" Text="Search to get started" Foreground="#6A7C90" HorizontalAlignment="Right"/></DockPanel>
     <DataGrid x:Name="ResultsGrid" Grid.Row="1" Margin="0,0,0,4" AutomationProperties.Name="Lookup results"/>
     <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock x:Name="EmptyTitle" Text="Your directory, ready to search" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyHint" Text="Enter a name above to see matching records." Foreground="#6A7C90" Margin="0,10,0,0" HorizontalAlignment="Center"/></StackPanel>
    </Grid></Border>
    <Border x:Name="DataPanel" Visibility="Collapsed" Background="White" CornerRadius="8" Padding="22"><ScrollViewer x:Name="DataScroll" VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="Refresh from an export" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Import replaces only the chosen local dataset. A database backup is created first. Use the full export you want included; a filtered export creates a filtered snapshot." TextWrapping="Wrap" Foreground="#63768A" Margin="0,9,0,16"/>
     <WrapPanel><Button x:Name="ImportDevices" Content="Import Entra device CSV" Margin="0,0,10,10"/><Button x:Name="ImportDefender" Content="Import Defender CSV" Margin="0,0,10,10"/><Button x:Name="ImportIntune" Content="Import Intune CSV" Margin="0,0,10,10"/><Button x:Name="ImportUsers" Content="Import user CSV" Margin="0,0,10,10"/><Button x:Name="ReloadSummary" Content="Reload details" Margin="0,0,0,10"/></WrapPanel>
     <TextBlock Text="Which CSV should I import?" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,8"/>
     <TextBlock Text="1. Entra devices: Entra admin center > Entra ID > Devices > All devices > Download devices. Required columns: id (Object ID), deviceId, displayName. Import with Import Entra device CSV.&#10;&#10;2. Entra users: Entra ID > Users > All users > Download users. Include id, displayName and userPrincipalName. Import with Import user CSV.&#10;&#10;3. Intune (optional): Intune admin center > Devices > All devices > Export. Include all inventory data. Extract the CSV from the downloaded ZIP. Required columns: Device ID, Device name, Azure AD Device ID. Import with Import Intune CSV.&#10;&#10;4. Defender (optional): Microsoft Defender portal > Assets > Devices > Export. Select the extracted device inventory CSV. Required columns: Device ID, Device Name, AAD Device Id. Import with Import Defender CSV. Blank AAD IDs remain searchable without an identity link.&#10;&#10;5. Group comparison: open Group membership. Import the All groups catalog, select a target, then import its complete Members > Download members CSV. A group catalog does not contain membership. Run a bulk lookup and use Compare group to export missing members only.&#10;&#10;Use UTF-8 CSV with a header row. Comma, semicolon and tab delimiters are supported. Use exports from the same tenant. Importing a dataset replaces only that dataset and retains the others.&#10;&#10;Bulk lookup lists are separate: use a DeviceName column for devices or a userPrincipalName column for users on the Bulk lookup pages. They search the imported database; they do not populate it.&#10;&#10;New organization or environment? Extract a fresh empty package into a separate folder. Existing databases and backups contain local data. See IMPORT-GUIDE.md for accepted column aliases and examples." TextWrapping="Wrap" Foreground="#63768A"/>
     <TextBlock x:Name="BrandingHeading" Text="Workspace branding" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,8"/>
     <TextBlock Text="Personalize this copy for an organization or environment. Settings apply immediately and stay in this folder. Fresh packages always use the default Directory Lens branding." TextWrapping="Wrap" Foreground="#63768A" Margin="0,0,0,12"/>
     <TextBlock Text="App name (up to 48 characters)"/><TextBox x:Name="BrandNameInput" MaxLength="48" Margin="0,5,0,10"/>
     <TextBlock Text="Subtitle (up to 64 characters)"/><TextBox x:Name="BrandSubtitleInput" MaxLength="64" Margin="0,5,0,10"/>
     <TextBlock Text="Accent color (#RRGGBB)"/><TextBox x:Name="BrandAccentInput" MaxLength="7" Margin="0,5,0,10"/>
     <CheckBox x:Name="BrandUseLogo" Content="Use custom PNG logo" Margin="0,0,0,10"/>
     <TextBlock x:Name="BrandLogoStatus" Text="No custom logo selected." TextWrapping="Wrap" Margin="0,0,0,10"/>
     <WrapPanel><Button x:Name="BrandChooseLogo" Content="Choose PNG logo" Margin="0,0,10,10"/><Button x:Name="BrandSave" Content="Save branding" Style="{StaticResource Primary}" Margin="0,0,10,10"/><Button x:Name="BrandReset" Content="Restore default branding" Margin="0,0,0,10"/></WrapPanel>
     <TextBlock Text="Snapshot details" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="SnapshotDetails" Text="Loading..." TextWrapping="Wrap" Margin="0,14,0,18" Foreground="#52657A"/>
     <TextBlock Text="About this workspace" FontSize="17" FontWeight="SemiBold" Margin="0,18,0,8"/><TextBlock Text="Searches run on this computer. Exported group CSVs contain Object IDs and must be uploaded manually in Entra. Intune primary-user assignments are shown separately from Entra owner labels. Only Azure AD Device IDs link datasets; names never establish a link. Intune-only records cannot be exported as group members.&#10;&#10;Keep a separate folder for each organization or environment. Share only the original empty package for a new workspace. Populated folders and backups contain imported data." TextWrapping="Wrap" Foreground="#63768A"/>
    </StackPanel></ScrollViewer></Border>
   </Grid>
   <StackPanel x:Name="ActionsPanel" Grid.Row="4" Margin="0,14,0,0">
    <TextBlock x:Name="SelectionLabel" Text="Select a result to copy its details." Foreground="#63768A" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
    <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="CompareGroup" Content="Compare group" Margin="10,0,0,0"/><Button x:Name="ExportResults" Content="Export results" IsEnabled="False" Margin="10,0,0,0"/><Button x:Name="ExportGroup" Content="Export group members" IsEnabled="False" Style="{StaticResource Primary}" Margin="10,0,0,0"/></StackPanel><WrapPanel><Button x:Name="ViewDetails" Content="Details" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="CopyName" Content="Copy name" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="CopyIdentifier" Content="Copy Device ID" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="CopyObject" Content="Copy Object ID" IsEnabled="False"/></WrapPanel></DockPanel>
   </StackPanel>
   <StackPanel Grid.Row="5" Margin="0,14,0,0"><ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,8"/><TextBlock x:Name="StatusText" Text="Ready" Foreground="#63768A" FontSize="11" TextWrapping="Wrap"/></StackPanel>
  </Grid>
 </Grid>
</Window>
