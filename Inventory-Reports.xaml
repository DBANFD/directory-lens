<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="1220" Height="840" MinWidth="960" MinHeight="680" WindowStartupLocation="CenterOwner" Background="#F3F5F8" FontFamily="Segoe UI" FontSize="13">
 <Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,8,0"/></Style></Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Inventory gaps and health" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Identity links use valid Entra Device IDs only. Names never join inventories. Reports describe imported snapshots, not current device state." TextWrapping="Wrap" Margin="0,8,0,14"/></StackPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,12"><Button x:Name="Refresh" Content="Refresh report" DockPanel.Dock="Right"/><ComboBox x:Name="Report" Padding="8" Margin="0,0,12,0"/></DockPanel>
  <Border Grid.Row="2" Background="White" Padding="12" Margin="0,0,0,12"><TextBlock x:Name="Snapshots" TextWrapping="Wrap" FontSize="12"/></Border>
  <DataGrid x:Name="Results" Grid.Row="3" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True"><DataGrid.Columns>
   <DataGridTextColumn Header="Device name" Binding="{Binding DeviceName}" Width="180"/>
   <DataGridTextColumn Header="Dataset" Binding="{Binding Dataset}" Width="90"/>
   <DataGridTextColumn Header="Assessment" Binding="{Binding Assessment}" Width="150"/>
   <DataGridTextColumn Header="Finding" Binding="{Binding Finding}" Width="380"/>
   <DataGridTextColumn Header="Entra Device ID" Binding="{Binding EntraDeviceId}" Width="280"/>
   <DataGridTextColumn Header="Source record ID" Binding="{Binding RecordId}" Width="300"/>
   <DataGridTextColumn Header="Owner text" Binding="{Binding OwnerText}" Width="220"/>
   <DataGridTextColumn Header="Entra records" Binding="{Binding EntraRecords}" Width="100"/>
   <DataGridTextColumn Header="Intune records" Binding="{Binding IntuneRecords}" Width="100"/>
   <DataGridTextColumn Header="Defender records" Binding="{Binding DefenderRecords}" Width="115"/>
  </DataGrid.Columns></DataGrid>
  <WrapPanel Grid.Row="4" Margin="0,12,0,12"><Button x:Name="Export" Content="Export current report" IsEnabled="False"/><Button x:Name="Kql" Content="KQL from current report" IsEnabled="False"/><Button x:Name="Close" Content="Close"/></WrapPanel>
  <TextBlock x:Name="Status" Grid.Row="5" TextWrapping="Wrap"/>
 </Grid>
</Window>
