<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Group membership" Width="1180" Height="850" MinWidth="940" MinHeight="720" WindowStartupLocation="CenterOwner" Background="#F3F5F8" FontFamily="Segoe UI" FontSize="13">
<Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,8,0"/></Style><Style TargetType="DataGrid"><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="RowHeight" Value="30"/></Style></Window.Resources>
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Group membership comparison" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Import the group catalog, select a group, then load its complete direct-member export. Compare an exact device/user lookup and export only missing Object IDs." TextWrapping="Wrap" Margin="0,6,0,12"/><TextBlock x:Name="ScopeText" TextWrapping="Wrap" Margin="0,0,0,8"/><Expander Header="Inventory snapshot dates (import time is not observation time)" Margin="0,0,0,10"><ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="SnapshotText" TextWrapping="Wrap" FontSize="11"/></ScrollViewer></Expander></StackPanel>
<DockPanel Grid.Row="1" Margin="0,0,0,10"><Button x:Name="ImportCatalog" Content="Import group catalog" DockPanel.Dock="Right"/><Button x:Name="Search" Content="Search groups" DockPanel.Dock="Right"/><TextBox x:Name="Query" Padding="9,7" ToolTip="Search by group name or full Object ID" Margin="0,0,10,0"/></DockPanel>
<TextBlock Grid.Row="2" Text="Select one target to import members or export an upload. Hold Ctrl or Shift to select several groups for one comparison. Search results are limited to 1,000 groups; narrow the search when needed." TextWrapping="Wrap" Margin="0,0,0,8"/>
<DataGrid x:Name="Groups" Grid.Row="3" SelectionMode="Extended"><DataGrid.Columns><DataGridTextColumn Header="Group name" Binding="{Binding DisplayName}" Width="260"/><DataGridTextColumn Header="Object ID" Binding="{Binding GroupId}" Width="280"/><DataGridTextColumn Header="Type" Binding="{Binding GroupType}" Width="130"/><DataGridTextColumn Header="Membership" Binding="{Binding MembershipType}" Width="110"/><DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="130"/><DataGridTextColumn Header="Members" Binding="{Binding MemberCount}" Width="80"/><DataGridTextColumn Header="Snapshot" Binding="{Binding MembershipSnapshot}" Width="100"/></DataGrid.Columns></DataGrid>
<StackPanel Grid.Row="4" Margin="0,12,0,10"><TextBlock x:Name="TargetText" Text="Select a group. No member snapshot is assumed." TextWrapping="Wrap"/><CheckBox x:Name="Complete" Content="I confirm the member CSV is the complete, unfiltered direct-member export for the selected group." Margin="0,10,0,0"/></StackPanel>
<WrapPanel Grid.Row="5" Margin="0,0,0,10"><Button x:Name="ImportMembers" Content="Import selected group's members" IsEnabled="False"/><Button x:Name="Compare" Content="Compare selected groups" IsEnabled="False"/></WrapPanel>
<DataGrid x:Name="Results" Grid.Row="6"><DataGrid.Columns>
<DataGridTextColumn Header="Target group" Binding="{Binding TargetGroup}" Width="180"/>
<DataGridTextColumn Header="Requested value" Binding="{Binding RequestedName}" Width="180"/>
<DataGridTextColumn Header="Comparison" Binding="{Binding Comparison}" Width="120"/>
<DataGridTextColumn Header="Age (days)" Binding="{Binding MembershipAgeDays}" Width="90"/>
<DataGridTextColumn Header="Imported UTC" Binding="{Binding MembershipImportedUtc}" Width="200"/>
<DataGridTextColumn Header="Source modified UTC" Binding="{Binding MembershipSourceModifiedUtc}" Width="200"/>
<DataGridTextColumn Header="Member Object ID" Binding="{Binding ObjectId}" Width="280"/>
<DataGridTextColumn Header="Target Object ID" Binding="{Binding TargetGroupId}" Width="280"/>
<DataGridCheckBoxColumn Header="Export eligible" Binding="{Binding GroupEligible}" Width="100"/>
</DataGrid.Columns></DataGrid>
<WrapPanel Grid.Row="7" Margin="0,12,0,12"><Button x:Name="ExportMissing" Content="Export missing members" IsEnabled="False"/><Button x:Name="ExportReport" Content="Export comparison report" IsEnabled="False"/><Button x:Name="Close" Content="Close"/></WrapPanel>
<StackPanel Grid.Row="8"><TextBlock Text="Snapshot comparison only. Unresolved/ambiguous inputs are excluded. Nested membership is not expanded. Dynamic, synchronized and unsupported group types are comparison-only. No tenant changes are made." TextWrapping="Wrap" Foreground="#52657A"/><TextBlock x:Name="Status" Text="Ready" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
</Grid></Window>